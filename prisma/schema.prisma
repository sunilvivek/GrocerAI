// GrocerAI — Prisma schema
// Milestone 2: authentication & database foundation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// How a user authenticated. Matches Better Auth's internal provider ids.
enum AccountProvider {
  credential // email + password
  google // Google OAuth
}

/// A named category for a saved delivery/billing address.
enum AddressType {
  HOME
  WORK
  OTHER
}

// ---------------------------------------------------------------------------
// Authentication models (managed by Better Auth via the Prisma adapter)
//
// NOTE: Better Auth generates its own ids for these tables, so `id` columns
// are plain `String` (not `@db.Uuid`). Custom models like `Address` use UUIDs.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  favorites Favorite[]

  @@map("users")
}
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String            @id
  accountId             String
  providerId            AccountProvider
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // only set for the `credential` provider
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Custom domain model — saved addresses (Milestone 3+: delivery & checkout)
// ---------------------------------------------------------------------------

model Address {
  id         String      @id @default(uuid()) @db.Uuid
  label      String      @default("Home")
  type       AddressType @default(HOME)
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String      @default("US")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog & recipes (Milestone 3)
// ---------------------------------------------------------------------------

/// Cooking difficulty shown on recipe cards.
enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  description    String?
  brand          String?
  image          String?
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) // sale: original price, when set
  unit           String   @default("each") // display unit: lb, oz, pack, each…
  unitAmount     Decimal  @default(1) @db.Decimal(8, 2) // e.g. 2 lb, 6 ct
  stock          Int      @default(0)
  isFeatured     Boolean  @default(false)
  isActive       Boolean  @default(true)
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  tags           String[] @default([])
  // Nutrition facts (per serving)
  servingSize    String?
  calories       Int?
  proteinGrams   Float?
  carbsGrams     Float?
  fatGrams       Float?
  fiberGrams     Float?
  sugarGrams     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String     @db.Uuid
  favorites  Favorite[]
  cartItems  CartItem[]

  @@index([categoryId])
  @@index([isFeatured])
  @@map("products")
}

model Ingredient {
  id       String   @id @default(uuid()) @db.Uuid
  name     String
  slug     String   @unique
  category String? // produce, dairy, pantry, meat, frozen…
  unit     String   @default("whole") // common unit: whole, cup, tbsp, lb…
  createdAt DateTime @default(now())

  recipeIngredients RecipeIngredient[]

  @@map("ingredients")
}

model Recipe {
  id                String           @id @default(uuid()) @db.Uuid
  title             String
  slug              String           @unique
  description       String?
  image             String?
  servings          Int              @default(4)
  prepTimeMinutes   Int              @default(10)
  cookTimeMinutes   Int              @default(20)
  difficulty        RecipeDifficulty @default(EASY)
  caloriesPerServing Int?
  tags              String[]         @default([])
  isPublished       Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  ingredients RecipeIngredient[]
  favorites   Favorite[]

  @@index([isPublished])
  @@map("recipes")
}

model RecipeIngredient {
  id           String  @id @default(uuid()) @db.Uuid
  quantity     Decimal @db.Decimal(8, 2)
  unit         String  @default("whole")
  note         String? // e.g. "diced", "room temperature"

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId   String     @db.Uuid
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientId String   @db.Uuid

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

/// A saved product or recipe. Exactly one of `product` / `recipe` is set.
model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String?  @db.Uuid
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String?  @db.Uuid

  @@unique([userId, productId])
  @@unique([userId, recipeId])
  @@index([userId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// Shopping cart (Milestone 5)
//
// A cart is keyed by `ownerId`, which is either the signed-in user id or an
// opaque anonymous token stored in a cookie. Guests and signed-in users share
// the same shape, which lets us merge an anonymous cart into a user's cart
// after login.
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid()) @db.Uuid
  quantity      Int      @default(1)
  savedForLater Boolean  @default(false) // moved to "Save for later"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String  @db.Uuid

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}
