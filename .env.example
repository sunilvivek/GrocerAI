# ------------------------------------------------------------------
# SmartCart AI — Environment Variables
# Copy this file to `.env.local` and fill in values as they become
# available. Milestone 1 ships with no secrets — everything below is
# reserved for future milestones (auth, database, AI, payments).
# ------------------------------------------------------------------

# The canonical public origin of the deployed app.
# Used for SEO/canonical URLs, absolute links, and server-side redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Reserved for Milestone 2+ (authentication)
# ------------------------------------------------------------------
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# ------------------------------------------------------------------
# Reserved for Milestone 3+ (database)
# ------------------------------------------------------------------
# DATABASE_URL=

# ------------------------------------------------------------------
# Reserved for Milestone 4+ (AI providers)
# ------------------------------------------------------------------
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------
# Reserved for Milestone 4+ (payments)
# ------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
