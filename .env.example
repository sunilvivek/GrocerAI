# ------------------------------------------------------------------
# GrocerAI — Environment Variables
# Copy this file to `.env.local` and fill in values.
# NEVER commit real secrets.
# ------------------------------------------------------------------

# The canonical public origin of the deployed app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Database (PostgreSQL — Neon recommended)
# Example Neon pooled connection string:
#   postgresql://USER:PASSWORD@HOST-REGION.pooler.supabase.com/DB?sslmode=require
# Local Postgres example:
#   postgresql://viveks@localhost:5432/grocerai
# ------------------------------------------------------------------
DATABASE_URL=postgresql://viveks@localhost:5432/grocerai

# ------------------------------------------------------------------
# Authentication — Better Auth
# ------------------------------------------------------------------
# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The base URL of your application. Must match where the app is served.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# AI — OpenAI (Vercel AI SDK)
# ------------------------------------------------------------------
# Get an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model used by the GrocerAI assistant. Keep this cheap and fast.
OPENAI_MODEL=gpt-4o-mini

# Sampling temperature (0 = deterministic, 1 = creative). Default: 0.7
OPENAI_TEMPERATURE=0.7
